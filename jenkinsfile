pipeline {
    agent any

    stages {
        stage('HelloWorld') {
            steps {
                echo '*Hello World*'
            }
        }
        
        stage('Docker Build') {
            steps {
                sh 'docker pull nginx'
            }
        }

        stage('Docker Run') {
            steps {
                sh 'docker run -d -p 800:800 nginx'
            }
        }

        stage('Docker Image and PS') {
            steps {
                sh 'docker image'
                sh 'docker ps'
            }
        }
        stage('Docker stop') {
            steps {
                sh 'docker stop nginx'
                sh 'docker prune -a'
            }
        }
    }
}
