pipeline {
    agent any

    stages {
        stage('HelloWorld') {
            steps {
                echo '*Hello World*'
            }
        }
        
        stage('Docker Build') {
            steps {
                sh 'docker pull httpd'
            }
        }

        stage('Docker Run') {
            steps {
                sh 'docker run -d -p 90:90 httpd'
            }
        }

        stage('Docker Image and PS') {
            steps {
                sh 'docker image'
                sh 'docker ps'
            }
        }
       stage('Docker Stop') {
            steps {
               sh 'docker stop $(docker ps -q --filter "ancestor=httpd")'
           }
        }
    }
}
